# AgentRail settlement (default: local EVM journal with real secp256k1 wallets)
SETTLEMENT_MODE=local

# Base Sepolia real USDC (also set via: npm run setup:base-sepolia:deploy)
# SETTLEMENT_MODE=base-sepolia
# CHAIN_RPC_URL=https://base-sepolia-rpc.publicnode.com
# SPONSOR_PRIVATE_KEY=0x...
# USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# FEE_RECIPIENT=0x...   # defaults to sponsor address when using setup script

AGENTRAIL_HMAC_SECRET=change-me-in-production

# Optional: programmatic faucet refill (sponsor must still hold ETH+USDC on-chain)
# CIRCLE_API_KEY=
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
# CDP_WALLET_SECRET=

# Optional Vercel KV
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
